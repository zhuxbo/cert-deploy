# sslctl 远程发布配置
# 复制为 release.conf 并填写实际值
# 重要：设置文件权限 chmod 600 release.conf

# ========================================
# 服务器配置
# ========================================
# 格式: "名称,主机,端口,目录"
# - 名称: 服务器标识，用于日志和全节点对账
# - 主机: SSH 主机地址
# - 端口: SSH 端口（默认 22）
# - 目录: 远程发布目录

SERVERS=(
    "node1,release1.example.com,22,/var/www/release/sslctl"
    "node2,release2.example.com,22,/var/www/release/sslctl"
)

# ========================================
# SSH 认证
# ========================================
# SSH 用户名
SSH_USER="release"

# SSH 私钥路径（支持 ~ 展开）
SSH_KEY="~/.ssh/release"

# ========================================
# 签名与公网入口（必需）
# ========================================
# Ed25519 base64 seed 文件，权限必须为 600
SIGN_KEY="build/keys/release-key.pem"
SIGN_KEY_ID="key-1"

# 统一公网入口，必须为 HTTPS；末尾不带 /releases.json
PUBLIC_RELEASE_URL="https://release.example.com/sslctl"

# ========================================
# 可选配置
# ========================================
# SSH 连接超时秒数（默认 10）
# SSH_TIMEOUT=10
